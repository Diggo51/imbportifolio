<script>
var _lastList=PROPS,_down=null;
function cardHTML(p){
var on=fav.indexOf(p.id)>-1?' on':'';
var tag=p.tag?'<span class="tag '+p.tagc+'">'+p.tag+'</span>':'';
return '<article class="prop" data-id="'+p.id+'">'+
'<div class="prop-img">'+tag+
'<button class="fav-btn'+on+'" data-fav="'+p.id+'" aria-label="Favoritar">&#9829;</button>'+
'<img src="'+p.img+'" alt="'+p.t+'" loading="lazy"></div>'+
'<div class="prop-body"><div class="prop-price">'+brl(p.pr)+' <small>'+(p.cond?'cond. '+brl(p.cond)+'/mes':'sem condominio')+'</small></div>'+
'<div class="prop-title">'+p.t+'</div><div class="prop-addr">'+p.b+' - '+p.ci+'</div>'+
'<div class="prop-specs"><span><b>'+p.bd+'</b> quartos</span><span><b>'+p.bt+'</b> banh.</span><span><b>'+p.pk+'</b> vagas</span><span><b>'+p.ar+'</b> m2</span></div>'+
'<div class="prop-actions" style="grid-template-columns:1fr 1fr"><button class="btn btn-line" data-open="'+p.id+'">Ver detalhes</button>'+
'<button class="btn btn-line" data-cart="'+p.id+'">+ Selecao</button>'+
'<a class="btn btn-wa" href="https://wa.me/5511999999999?text='+encodeURIComponent('Ola! Vi o imovel: '+p.t)+'" target="_blank" style="grid-column:1/-1">WhatsApp</a></div></div></article>'}
renderProps=function(list){_lastList=list;var g=document.getElementById('grid'),h='';
if(!list.length){g.innerHTML='<div class="empty">Nenhum imovel encontrado. Tente outro bairro ou tipo.</div>';return}
for(var i=0;i<list.length;i++)h+=cardHTML(list[i]);g.innerHTML=h};
toggleFav=function(id){var i=fav.indexOf(id);
if(i>-1){fav.splice(i,1);toast('Removido dos favoritos')}
else{fav.push(id);toast('Salvo nos favoritos!')}
localStorage.setItem('hz-fav',JSON.stringify(fav));renderProps(_lastList);
if(typeof updateCounts==='function')updateCounts();
if(document.getElementById('drawer').classList.contains('on'))paintDrawer()};
document.getElementById('grid').addEventListener('pointerdown',function(e){_down={x:e.clientX,y:e.clientY}});
document.getElementById('grid').addEventListener('pointerup',function(e){
if(!_down)return;var dx=e.clientX-_down.x,dy=e.clientY-_down.y;_down=null;
if(Math.sqrt(dx*dx+dy*dy)>10)return;
var t=e.target,el;
el=t.closest?t.closest('[data-fav]'):null;
if(el){toggleFav(parseInt(el.getAttribute('data-fav')));return}
el=t.closest?t.closest('[data-cart]'):null;
if(el){addCart(parseInt(el.getAttribute('data-cart')));return}
el=t.closest?t.closest('[data-open]'):null;
if(el){openDetail(parseInt(el.getAttribute('data-open')));return}
el=t.closest?t.closest('.prop-img'):null;
if(el){openDetail(parseInt(el.closest('.prop').getAttribute('data-id')))}
});
renderProps(_lastList);
</script>
